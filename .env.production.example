# ── Thunai production .env ──
# Copy to .env and fill in values

# MongoDB (leave blank to run in-memory demo mode)
MONGODB_URI=mongodb://mongo:27017/thunai

# Twilio (leave blank for mock mode)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Bhashini ASR/TTS (leave blank for mock mode)
BHASHINI_API_KEY=
BHASHINI_USER_ID=

# Dashboard CORS origin
DASHBOARD_ORIGIN=http://localhost:3000

# Public base URL (for Twilio webhook validation)
PUBLIC_BASE_URL=https://your-deployment.onrender.com
