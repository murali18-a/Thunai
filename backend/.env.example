# Thunai backend environment
PORT=4000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/thunai

# Twilio / Exotel (use Twilio sandbox for demo)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+15005550006
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Bhashini (Govt of India language stack)
BHASHINI_USER_ID=your_user_id
BHASHINI_API_KEY=your_api_key
BHASHINI_ASR_URL=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/compute
BHASHINI_TTS_URL=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/compute

# Public base URL (ngrok during dev)
PUBLIC_BASE_URL=https://your-ngrok-id.ngrok.io

# Dashboard
DASHBOARD_ORIGIN=http://localhost:5173
